{
  "name": "ard-angular-skeleton",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "audit": "pnpm audit --fix",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "api:build": "pnpm --filter @ard/api-spec build",
    "api:generate": "swagger-typescript-api generate -p api-spec/dist/openapi.yaml -o src/app/data/generated -n api-client.ts",
    "api:sync": "pnpm run api:build && pnpm run api:generate"
  },
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@angular/aria": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "swagger-typescript-api": "^13.0.23",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
