{
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "git",
        "url": "https://github.com/mattpocock/skills.git"
      },
      "autoUpdate": false
    }
  },
  "permissions": {
    "deny":[      
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(npm update*)",
      "Bash(yarn add*)",
      "Bash(yarn remove*)",
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Bash(pip install*)",
      "Bash(pip uninstall*)",
      "Bash(poetry add*)",
      "Bash(poetry remove*)",
      "Bash(cargo add*)",
      "Bash(cargo remove*)",
      "Write(node_modules/**)",
      "Write(**/node_modules/**)",
      "Edit(node_modules/**)",
      "Edit(**/node_modules/**)",
      "MultiEdit(node_modules/**)",
      "MultiEdit(**/node_modules/**)"
    ]
  }
}
